rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function userProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().data.role == "admin"
        && userProfile().data.accountStatus == "active";
    }

    function isActiveStaff() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().data.role in ["admin", "staff"]
        && userProfile().data.accountStatus == "active";
    }

    function isActiveClinicalUser() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && userProfile().data.role in ["doctor", "nurse"]
        && userProfile().data.accountStatus == "active";
    }

    function isActiveSystemUser() {
      return isActiveStaff() || isActiveClinicalUser();
    }

    function validSystemRole(role) {
      return role in ["admin", "staff", "nurse", "doctor"];
    }

    function validAccountStatus(status) {
      return status in ["active", "disabled", "missing"];
    }

    function validShortString(value, maxLength) {
      return value is string && value.size() <= maxLength;
    }

    function validOptionalImageDataUrl(value) {
      return value == ""
        || (
          value is string
          && value.size() <= 921600
          && value.matches("^data:image/(jpeg|jpg|png|webp);base64,[A-Za-z0-9+/=]+$")
        );
    }

    function validUserProfileShape() {
      return validSystemRole(request.resource.data.role)
        && validAccountStatus(request.resource.data.accountStatus)
        && (!("fullName" in request.resource.data) || validShortString(request.resource.data.fullName, 160))
        && (!("email" in request.resource.data) || validShortString(request.resource.data.email, 254))
        && (!("phone" in request.resource.data) || validShortString(request.resource.data.phone, 40))
        && (!("position" in request.resource.data) || validShortString(request.resource.data.position, 120))
        && (!("department" in request.resource.data) || validShortString(request.resource.data.department, 120))
        && (!("clinic" in request.resource.data) || validShortString(request.resource.data.clinic, 120))
        && (!("specialty" in request.resource.data) || validShortString(request.resource.data.specialty, 120))
        && (!("licenseNumber" in request.resource.data) || validShortString(request.resource.data.licenseNumber, 80))
        && (!("restrictionReason" in request.resource.data) || validShortString(request.resource.data.restrictionReason, 300))
        && (!("photoDataUrl" in request.resource.data) || validOptionalImageDataUrl(request.resource.data.photoDataUrl))
        && (!("clinicalCoverDataUrl" in request.resource.data) || validOptionalImageDataUrl(request.resource.data.clinicalCoverDataUrl));
    }

    function validChartRequestTransition(currentStatus, nextStatus) {
      return currentStatus == nextStatus
        || (currentStatus == "pending" && nextStatus in ["preparing", "canceled"])
        || (currentStatus == "preparing" && nextStatus in ["ready", "canceled"])
        || (currentStatus == "ready" && nextStatus in ["received", "canceled"])
        || (currentStatus == "received" && nextStatus in ["completed", "canceled"]);
    }

    function isTerminalReleaseStatus(status) {
      return status in ["released", "canceled", "voided"];
    }

    function isValidCaseNumber(caseNumber) {
      return caseNumber is string && caseNumber.size() > 0 && caseNumber.size() <= 60;
    }

    function isSelfRenameDelete(collectionName, caseNumber) {
      return isActiveStaff()
        && resource.data.renamePendingBy == request.auth.uid
        && isValidCaseNumber(resource.data.renamePendingTo)
        && exists(/databases/$(database)/documents/$(collectionName)/$(resource.data.renamePendingTo))
        && get(/databases/$(database)/documents/$(collectionName)/$(resource.data.renamePendingTo)).data.previousCaseNumber == caseNumber
        && get(/databases/$(database)/documents/$(collectionName)/$(resource.data.renamePendingTo)).data.renamePendingBy == request.auth.uid;
    }

    match /users/{userId} {
      allow create: if isAdmin()
        && validUserProfileShape()
        && request.resource.data.role in ["staff", "nurse", "doctor"]
        && request.resource.data.accountStatus == "active";

      allow read: if signedIn()
        && (
          request.auth.uid == userId
          || isAdmin()
          || (isActiveStaff() && resource.data.role == "doctor")
        );
      allow update: if (isAdmin() && validUserProfileShape())
        || (
          signedIn()
          && request.auth.uid == userId
          && validUserProfileShape()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName",
            "email",
            "phone",
            "position",
            "department",
            "photoDataUrl",
            "clinicalCoverDataUrl",
            "updatedAt"
          ])
          && request.resource.data.role == resource.data.role
          && validSystemRole(request.resource.data.role)
          && request.resource.data.accountStatus == resource.data.accountStatus
        );
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /patients/{caseNumber} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff()
        && request.resource.data.caseNumber == caseNumber
        && isValidCaseNumber(request.resource.data.caseNumber)
        && request.resource.data.name is string
        && request.resource.data.type in ["inpatient", "outpatient"];
      allow delete: if isAdmin() || isSelfRenameDelete("patients", caseNumber);
    }

    match /charts/{caseNumber} {
      allow read: if isActiveSystemUser();
      allow create, update: if isActiveStaff()
        && request.resource.data.caseNumber == caseNumber
        && isValidCaseNumber(request.resource.data.caseNumber);
      allow delete: if isAdmin() || isSelfRenameDelete("charts", caseNumber);
    }

    match /chartLogs/{logId} {
      allow read: if isActiveStaff();
      allow create, update: if isActiveStaff();
      allow delete: if isAdmin();
    }

    match /chartRequests/{requestId} {
      allow read: if isActiveStaff()
        || (isActiveClinicalUser() && resource.data.requestedById == request.auth.uid);
      allow create: if isActiveSystemUser()
        && request.resource.data.requestedById == request.auth.uid
        && request.resource.data.status == "pending"
        && isValidCaseNumber(request.resource.data.caseNumber)
        && request.resource.data.patientName is string;
      allow update: if (
          isActiveStaff()
          && request.resource.data.requestedById == resource.data.requestedById
          && request.resource.data.caseNumber == resource.data.caseNumber
          && request.resource.data.patientName == resource.data.patientName
          && validChartRequestTransition(resource.data.status, request.resource.data.status)
          && request.resource.data.status != "received"
        )
        || (
          isActiveClinicalUser()
          && resource.data.requestedById == request.auth.uid
          && request.resource.data.requestedById == resource.data.requestedById
          && request.resource.data.caseNumber == resource.data.caseNumber
          && request.resource.data.patientName == resource.data.patientName
          && (
            (
              resource.data.status == "pending"
              && request.resource.data.status == "canceled"
            )
            || (
              resource.data.status == "ready"
              && request.resource.data.status == "received"
            )
          )
        );
      allow delete: if isAdmin();
    }

    match /userNotifications/{notificationId} {
      allow read: if signedIn()
        && (
          resource.data.targetUserId == request.auth.uid
          || (isActiveStaff() && resource.data.targetRole == "medicalRecords")
        );
      allow create: if isActiveSystemUser()
        && request.resource.data.sourceUserId == request.auth.uid
        && (
          request.resource.data.targetUserId is string
          || request.resource.data.targetRole == "medicalRecords"
        );
      allow update, delete: if false;
    }

    match /departments/{departmentId} {
      allow read: if isActiveStaff();
      allow create, update, delete: if isAdmin();
    }

    match /medicalDocumentRequests/{requestId} {
      allow read, create: if isActiveStaff();
      allow update: if isActiveStaff() && !isTerminalReleaseStatus(resource.data.releaseStatus);
      allow delete: if isAdmin();
    }

    match /labResultRequests/{requestId} {
      allow read, create: if isActiveStaff();
      allow update: if isActiveStaff() && !isTerminalReleaseStatus(resource.data.releaseStatus);
      allow delete: if isAdmin();
    }

    match /vitalCertificateRequests/{requestId} {
      allow read, create: if isActiveStaff();
      allow update: if isActiveStaff() && !isTerminalReleaseStatus(resource.data.releaseStatus);
      allow delete: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow create: if isActiveSystemUser() && request.resource.data.userId == request.auth.uid;
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
